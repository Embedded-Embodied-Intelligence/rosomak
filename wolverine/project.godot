; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rosomak"
run/main_scene="res://scenes/game.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":68)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":83)]
}
look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":4194319)]
}
look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":4194321)]
}
look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":4194320)]
}
look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":4194322)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0), Object(InputEventMouseButton,"device":-1,"button_index":1), Object(InputEventKey,"device":-1,"physical_keycode":74)]
}
dodge={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":0), Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventKey,"device":-1,"physical_keycode":4194325)]
}
rage={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":3), Object(InputEventKey,"device":-1,"physical_keycode":81)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":6), Object(InputEventKey,"device":-1,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player body"
3d_physics/layer_3="Enemy body"
3d_physics/layer_4="Enemy hurtbox"
3d_physics/layer_5="Player attack"
3d_physics/layer_6="Player hurtbox"
3d_physics/layer_7="Enemy attack"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=1024
